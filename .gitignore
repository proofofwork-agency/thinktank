# Git worktrees created by concurrent Claude Code sessions. These are full checkouts
# of THIS repo on other branches — never commit them (a nested checkout inside the
# repo is meaningless, and they carry .git pointers back to the parent).
.claude/worktrees/

# rapana runtime / market data (not source)
concepts/rapana/data/
concepts/rapana/journal/
concepts/rapana/logs/
concepts/rapana/state/
concepts/rapana/.venv/

# local agent / runtime noise inside concepts
**/.contextrelay/
**/.claude/
