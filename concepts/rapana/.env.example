# =============================================================================
# RAPANA environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# =============================================================================

# --- Runtime ---
# "paper" (no real orders, default) | "live" (real orders — guarded by risk gates)
RAPANA_ENV=paper
RAPANA_LOG_LEVEL=INFO
# Absolute path to a kill-switch flag file. If it exists, the fleet halts.
RAPANA_KILL_SWITCH_PATH=./state/KILL_SWITCH
# Human-attested live gate: set to true ONLY after confirming in the MEXC dashboard
# that this API key has withdraw DISABLED. Cannot be checked via API; fail-closed.
RAPANA_WITHDRAW_VERIFIED=false

# --- MEXC (read-only key for Phase 0; NO withdraw permission) ---
# Create at https://www.mexc.com/user/openapi
# Permissions: READ ONLY. Do NOT enable trade or withdraw for this key.
MEXC_API_KEY=
MEXC_API_SECRET=
# Bind this key to a static egress IP in the MEXC dashboard (prevents 90-day expiry).
MEXC_API_BIND_IP=

# --- Markets to watch (comma-separated MEXC spot symbols) ---
RAPANA_WATCH_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# --- Storage ---
RAPANA_DB_PATH=./data/rapana.db
RAPANA_JOURNAL_PATH=./journal/decisions.jsonl

# --- Capital budget (hard ceiling; micro accounts) ---
# Set this to your max bankroll so order caps never exceed it.
# Example micro: RAPANA_CAPITAL_BUDGET_USD=50  → max order ≤ $47.50
# RAPANA_CAPITAL_BUDGET_USD=50

# --- Risk policy (Phase 0 defaults; tune before going live) ---
# All percentages are fractions of total allocated capital (0.01 = 1%).
# --- MICRO ($50) PROFILE (uncomment + set budget above) ---
# RAPANA_WATCH_SYMBOLS=BNB/USDT
# RAPANA_EXECUTION_MODE=maker
# RAPANA_VOL_TARGET=0.50
# RAPANA_RISK_MAX_POSITION_PCT=0.95
# RAPANA_RISK_MAX_TOTAL_EXPOSURE_PCT=0.95
# RAPANA_RISK_MAX_DAILY_LOSS_PCT=0.05
# RAPANA_RISK_MAX_ORDERS_PER_MIN=2
# RAPANA_RISK_MAX_NOTIONAL_PER_ORDER=47.50
# RAPANA_ENV=paper
RAPANA_RISK_MAX_POSITION_PCT=0.10
RAPANA_RISK_MAX_TOTAL_EXPOSURE_PCT=0.50
RAPANA_RISK_MAX_DAILY_LOSS_PCT=0.03
RAPANA_RISK_MAX_ORDERS_PER_MIN=6
RAPANA_RISK_MAX_NOTIONAL_PER_ORDER=250
# Reject any quote further than this fraction from reference price (0.05 = 5%).
RAPANA_RISK_SANITY_PRICE_BAND=0.05

# --- Autopilot (autonomous capital scaling / de-risking; OFF by default) ---
# When enabled, the fleet promotes staged live capital on sustained risk-adjusted
# evidence and de-risks/halts on drawdown — no human in the loop. Keep disabled
# until you trust the replay/paper evidence. (No effect in paper mode, where the
# full simulated balance always trades.)
RAPANA_AUTOPILOT=false
# Legacy diagnostic threshold; promotion now uses PSR + cash benchmark gates.
RAPANA_AUTOPILOT_PROMOTE_SHARPE=1.0
# Probabilistic Sharpe Ratio required to promote.
RAPANA_AUTOPILOT_PROMOTE_PSR=0.95
# Minimum number of cycles before a promotion can fire.
RAPANA_AUTOPILOT_PROMOTE_MIN_CYCLES=500
# Promote only if HISTORICAL max drawdown stayed under this fraction (clean run).
RAPANA_AUTOPILOT_PROMOTE_MAX_DD=0.10
# Fallback annualization basis when performance records have no timestamp span.
RAPANA_AUTOPILOT_PROMOTE_CYCLES_PER_YEAR=365
# CURRENT drawdown that triggers an automatic de-risk (reset to stage 1).
RAPANA_AUTOPILOT_DEMOTE_DD=0.08
# CURRENT drawdown that trips the kill switch and halts the fleet.
RAPANA_AUTOPILOT_HALT_DD=0.20

# --- Benchmarking (honest idle-cash opportunity cost) ---
RAPANA_BENCHMARK_CASH_RETURN=0.035

# --- Live sizing (vol targeting; OFF unless RAPANA_VOL_TARGET is set) ---
# Annualized target volatility, e.g. 0.35. Leave unset to preserve flat-cap sizing.
# RAPANA_VOL_TARGET=0.35
RAPANA_VOL_LOOKBACK=20

# --- Execution mode (maker is opt-in; default preserves current market path) ---
RAPANA_EXECUTION_MODE=market
RAPANA_MAKER_POLL_TIMEOUT_SEC=2.0
RAPANA_MAKER_POLL_INTERVAL_SEC=0.25
RAPANA_MAKER_PRICE_PEG=passive_touch
RAPANA_MAKER_PRICE_OFFSET_TICKS=0
RAPANA_PAPER_MAKER_FILL_FRACTION=0

# --- LLM brain (optional; provider=none keeps fleet fully offline/deterministic) ---
RAPANA_LLM_PROVIDER=none   # none|openrouter|ollama|openai|openai-compatible|local
RAPANA_LLM_BASE_URL=
RAPANA_LLM_API_KEY=
RAPANA_LLM_MODEL=
# Add the LLM regime analyst to the FORWARD fleet (one fenced vote through the
# deterministic gate). Only active when a real brain is configured above; no-op
# otherwise. Never used in replay/backtest (lookahead). Set a provider first.
RAPANA_LLM_REGIME_ENABLED=false

# --- External alpha feeds (sentiment + macro). OFF by default.
# Enable for FORWARD paper/live only. Replay/backtest always ignore these
# (a live "now" reading must never leak into a past bar). Both feeds fail soft.
RAPANA_FEEDS_ENABLED=false
# Optional CoinGecko paid-plan key (Basic/Analyst/Lite/Pro). When set, the
# market-premium feed uses the authenticated pro-api host (higher rate limits,
# commercial license). Leave blank for the free public endpoint.
RAPANA_COINGECKO_API_KEY=

# CryptoRank API (token unlock/vesting data)
CRYPTORANK_API_KEY=your_cryptorank_api_key_here
