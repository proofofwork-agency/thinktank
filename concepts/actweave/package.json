{
  "name": "actweave",
  "version": "0.2.0",
  "description": "Record, replay, and govern Vercel AI SDK agents in CI — no API keys. JSONL evidence ledgers and vitest-native trajectory assertions.",
  "type": "module",
  "sideEffects": false,
  "author": "Danillo Felixdaal (proofofwork-agency)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proofofwork-agency/thinktank.git",
    "directory": "concepts/actweave"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ledger": {
      "types": "./dist/ledger/index.d.ts",
      "import": "./dist/ledger/index.js"
    },
    "./record": {
      "types": "./dist/record/index.d.ts",
      "import": "./dist/record/index.js"
    },
    "./check": {
      "types": "./dist/check/index.d.ts",
      "import": "./dist/check/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay/index.js"
    },
    "./govern": {
      "types": "./dist/govern/index.d.ts",
      "import": "./dist/govern/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:legacy": "node scripts/check-legacy-names.mjs",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "record:dogfood": "npm run build && node scripts/record-dogfood.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:legacy"
  },
  "peerDependencies": {
    "ai": ">=6.0.0 <7",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "ai": "6.0.199",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
